{
  "entities": {
    "enquiry": {
      "title": "Enquiry",
      "description": "A contact form submission or inquiry from a user",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The sender's name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150,
          "description": "The sender's email address"
        },
        "subject": {
          "type": "string",
          "maxLength": 200,
          "description": "The message subject"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "The actual message content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The server-side creation timestamp"
        }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "enquiries/{enquiryId}": {
      "schema": "enquiry",
      "description": "All contact submissions"
    }
  }
}
